// Ergänzung zu GraphHoppers bike.json: Berliner Kopfsteinpflaster und schlechte Oberflächen meiden.
{
   "priority": [
    { "if": "surface == COBBLESTONE", "multiply_by": "0.5" },
    { "if": "smoothness == BAD || smoothness == VERY_BAD", "multiply_by": "0.6" }
  ],
  "speed": [
      { "if": "surface == COBBLESTONE", "limit_to": "12" }
  ],
  // Betreten und Verlassen eines Sperrgebiets (von tag_landuse.py mit hazmat=no
  // markiert) kostet je 600 s, unabhängig von der Länge der Wege.
  "turn_penalty": [
    { "if": "prev_hazmat != hazmat", "add": "600" }
  ]
}
