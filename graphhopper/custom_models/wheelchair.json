// Rollstuhl / Kinderwagen: auf Basis der Fußgänger-Werte, aber ohne Treppen,
// Wanderwege und schlechte Oberflächen. Bordsteinhöhen und Steigungen sind
// (noch) nicht berücksichtigt; Berlin ist weitgehend flach.
{
   "priority": [
    {
      "if": "hazmat == NO",
      "multiply_by": "0.1"
    },	
    { "if": "!foot_access || road_class == STEPS || hike_rating >= 1", "multiply_by": "0" },
    { "else": "", "multiply_by": "foot_priority" },
    { "if": "foot_road_access == PRIVATE", "multiply_by": "0.1" },
    { "if": "country == DEU && road_class == BRIDLEWAY && foot_road_access != YES", "multiply_by": "0" },

    { "if": "smoothness == IMPASSABLE || smoothness == VERY_HORRIBLE || smoothness == HORRIBLE", "multiply_by": "0" },
    { "else_if": "smoothness == VERY_BAD", "multiply_by": "0.1" },
    { "else_if": "smoothness == BAD", "multiply_by": "0.3" },

    { "if": "surface == SAND || surface == GRASS || surface == DIRT || surface == GROUND || surface == GRAVEL", "multiply_by": "0.1" },
    { "else_if": "surface == COBBLESTONE || surface == UNPAVED", "multiply_by": "0.3" },
    { "else_if": "surface == COMPACTED || surface == FINE_GRAVEL", "multiply_by": "0.8" },

    { "if": "track_type == GRADE3 || track_type == GRADE4 || track_type == GRADE5", "multiply_by": "0.2" }
  ],
  "speed": [
    { "if": "true", "limit_to": "foot_average_speed" },
    { "if": "true", "limit_to": "4" }
  ]
}
